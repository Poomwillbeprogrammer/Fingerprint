<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-19T14:58:00.000Z" agent="Antigravity AI" version="21.0.0" type="device"><diagram id="IoT-Biometric-Workflow" name="IoT Biometric Basic Workflow"><mxGraphModel dx="2000" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c_enroll" value="โหมดลงทะเบียนผู้ใช้ใหม่ (User Enrollment Flow)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;strokeWidth=2;fontColor=#fbbf24;fontStyle=1;fontSize=15;startSize=40;rounded=1;arcSize=4;" parent="1" vertex="1"><mxGeometry x="50" y="240" width="520" height="950" as="geometry" /></mxCell><mxCell id="c_scan" value="โหมดสแกนลงเวลาเรียนปกติ (Attendance Scan Flow)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;strokeWidth=2;fontColor=#38bdf8;fontStyle=1;fontSize=15;startSize=40;rounded=1;arcSize=4;" parent="1" vertex="1"><mxGeometry x="630" y="240" width="1050" height="2180" as="geometry" /></mxCell><mxCell id="start" value="เริ่มต้นระบบ (System Start)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#0f766e;strokeColor=#14b8a6;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" parent="1" vertex="1"><mxGeometry x="620" y="40" width="200" height="55" as="geometry" /></mxCell><mxCell id="dec_adduser" value="ได้กดปุ่ม &quot;เพิ่มผู้ใช้&quot;&lt;br/&gt;หรือไม่?&lt;br/&gt;(Add User Clicked?)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="610" y="130" width="220" height="85" as="geometry" /></mxCell><mxCell id="e_start_dec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="start" target="dec_adduser" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="enr_input" value="&lt;b&gt;1. แอดมินกรอกข้อมูลบน Web UI&lt;/b&gt;&lt;br/&gt;- รหัสนักศึกษา 12 หลัก (XXXXXXXXXXX-X)&lt;br/&gt;- ชื่อ-นามสกุล" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e293b;strokeColor=#475569;strokeWidth=2;fontColor=#f8fafc;fontSize=12;" parent="1" vertex="1"><mxGeometry x="160" y="310" width="300" height="70" as="geometry" /></mxCell><mxCell id="enr_val" value="&lt;b&gt;2. ตรวจสอบข้อมูล &amp; คำนวณ Slot&lt;/b&gt;&lt;br/&gt;- ตรวจสอบรูปแบบ 12 หลัก &amp; รหัสซ้ำ&lt;br/&gt;- รัน Slot ID ว่างอัตโนมัติ (1 คน = 3 Slots)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e293b;strokeColor=#475569;strokeWidth=2;fontColor=#f8fafc;fontSize=12;" parent="1" vertex="1"><mxGeometry x="160" y="415" width="300" height="70" as="geometry" /></mxCell><mxCell id="enr_cmd" value="&lt;b&gt;3. Server ส่งคำสั่งไปยังฮาร์ดแวร์&lt;/b&gt;&lt;br/&gt;ส่ง &lt;code&gt;ENROLL &amp;lt;slot&amp;gt;&lt;/code&gt; ผ่าน Socket.IO Bridge&lt;br/&gt;ไปยัง STM32 และเซนเซอร์ R307" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e3a8a;strokeColor=#3b82f6;strokeWidth=2;fontColor=#ffffff;fontSize=12;" parent="1" vertex="1"><mxGeometry x="160" y="520" width="300" height="70" as="geometry" /></mxCell><mxCell id="enr_loop" value="&lt;b&gt;4. ขั้นตอนสแกนลายนิ้วมือ 3 นิ้ว (3-Finger)&lt;/b&gt;&lt;br/&gt;• แตะนิ้วที่ 1 ซ้ำ 2 ครั้ง &amp;rarr; RESP:ENROLL_SLOT_DONE&lt;br/&gt;• แตะนิ้วที่ 2 ซ้ำ 2 ครั้ง &amp;rarr; RESP:ENROLL_SLOT_DONE&lt;br/&gt;• แตะนิ้วที่ 3 ซ้ำ 2 ครั้ง &amp;rarr; ดึง Template (~120ms)&lt;br/&gt;&lt;i&gt;(มี In-place Retry สูงสุด 3 ครั้งเมื่อภาพไม่ชัด)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e3a8a;strokeColor=#3b82f6;strokeWidth=2;fontColor=#ffffff;fontSize=12;" parent="1" vertex="1"><mxGeometry x="130" y="625" width="360" height="130" as="geometry" /></mxCell><mxCell id="enr_dec" value="&lt;b&gt;สแกนครบ 3 นิ้ว&lt;br/&gt;สำเร็จหรือไม่?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="210" y="790" width="200" height="80" as="geometry" /></mxCell><mxCell id="enr_save" value="&lt;b&gt;5. บันทึกข้อมูลสำเร็จ (Success)&lt;/b&gt;&lt;br/&gt;- ดึง Template (Hex) บันทึกลง Supabase&lt;br/&gt;- ซิงก์แคช &lt;code&gt;users_cache.json&lt;/code&gt; บนบอร์ด Uno Q&lt;br/&gt;- หน้าจอ TFT &amp;amp; เว็บแจ้ง &quot;ลงทะเบียนสำเร็จ&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#065f46;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="80" y="915" width="220" height="85" as="geometry" /></mxCell><mxCell id="enr_rollback" value="&lt;b&gt;ยกเลิก / สแกนไม่ผ่าน (Auto-Rollback)&lt;/b&gt;&lt;br/&gt;- สั่งล้าง Slot ที่บันทึกไปแล้วใน R307&lt;br/&gt;- ลบข้อมูลใน DB ป้องกัน Orphan Records&lt;br/&gt;- คืนสถานะพร้อมใช้งาน" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#881337;strokeColor=#f43f5e;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="330" y="915" width="210" height="85" as="geometry" /></mxCell><mxCell id="enr_end" value="สิ้นสุดการลงทะเบียน&lt;br/&gt;(Ready for Next Action)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#0f766e;strokeColor=#14b8a6;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" parent="1" vertex="1"><mxGeometry x="210" y="1050" width="200" height="55" as="geometry" /></mxCell><mxCell id="e_dec_enr" value="ใช่ (Yes)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontStyle=1;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="dec_adduser" target="enr_input" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_enr_1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="enr_input" target="enr_val" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_enr_2_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="enr_val" target="enr_cmd" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_enr_3_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="enr_cmd" target="enr_loop" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_enr_4_dec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="enr_loop" target="enr_dec" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_enr_dec_yes" value="สำเร็จครบ 3 นิ้ว" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontStyle=1;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="enr_dec" target="enr_save" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_enr_dec_no" value="ยกเลิก / ล้มเหลว" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;fontColor=#fb7185;fontStyle=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="enr_dec" target="enr_rollback" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_enr_save_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="enr_save" target="enr_end" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_enr_roll_end" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="enr_rollback" target="enr_end" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="scan_idle" value="&lt;b&gt;1. หน้าจอสแตนด์บาย (Idle Screen)&lt;/b&gt;&lt;br/&gt;จอ 1.8&quot; TFT แสดงผลชื่อห้องและเวลา&lt;br/&gt;เช่น &lt;code&gt;[ ทค.1-101 ] พร้อมใช้งาน&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e3a8a;strokeColor=#3b82f6;strokeWidth=2;fontColor=#ffffff;fontSize=12;" parent="1" vertex="1"><mxGeometry x="980" y="310" width="320" height="65" as="geometry" /></mxCell><mxCell id="scan_touch" value="&lt;b&gt;2. นักศึกษาวางนิ้วบนเซนเซอร์&lt;/b&gt;&lt;br/&gt;เซนเซอร์ Optical R307 ตรวจจับและดึงภาพลายนิ้วมือ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e293b;strokeColor=#475569;strokeWidth=2;fontColor=#f8fafc;fontSize=12;" parent="1" vertex="1"><mxGeometry x="980" y="410" width="320" height="55" as="geometry" /></mxCell><mxCell id="scan_search_t1" value="&lt;b&gt;3. ค้นหาใน Flash Memory ของเซนเซอร์&lt;/b&gt;&lt;br/&gt;ค้นหาภายใน 300 Slots บนฮาร์ดแวร์ R307" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e3a8a;strokeColor=#3b82f6;strokeWidth=2;fontColor=#ffffff;fontSize=12;" parent="1" vertex="1"><mxGeometry x="980" y="495" width="320" height="55" as="geometry" /></mxCell><mxCell id="scan_dec_t1" value="&lt;b&gt;พบลายนิ้วมือ&lt;br/&gt;ใน R307 (Tier 1)?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1035" y="580" width="210" height="80" as="geometry" /></mxCell><mxCell id="scan_t1_found" value="&lt;b&gt;🟢 Tier 1 Match (&amp;lt; 0.2 วินาที)&lt;/b&gt;&lt;br/&gt;- แปลง Slot ID &amp;rarr; User ID&lt;br/&gt;- ดึงชื่อ-สกุล จาก Local Cache (Offline 100%)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#065f46;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="850" y="700" width="260" height="75" as="geometry" /></mxCell><mxCell id="scan_t2_search" value="&lt;b&gt;🔵 Tier 2 Search (Cloud Database)&lt;/b&gt;&lt;br/&gt;- สตรีม Template สดขึ้น Cloud Server&lt;br/&gt;- ค้นหาเปรียบเทียบกับ Template ใน Supabase" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e293b;strokeColor=#475569;strokeWidth=2;fontColor=#f8fafc;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1180" y="700" width="280" height="75" as="geometry" /></mxCell><mxCell id="scan_dec_t2" value="&lt;b&gt;พบลายนิ้วมือ&lt;br/&gt;บน Cloud?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1220" y="810" width="200" height="80" as="geometry" /></mxCell><mxCell id="scan_t2_promote" value="&lt;b&gt;พบลายนิ้วมือ (Tier 2 Match)&lt;/b&gt;&lt;br/&gt;- ดึงข้อมูลชื่อ-รหัสนักศึกษา&lt;br/&gt;- ระบบทำ &lt;b&gt;LRU Auto-Promote&lt;/b&gt; เขียนลง R307" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#065f46;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1070" y="930" width="260" height="70" as="geometry" /></mxCell><mxCell id="scan_denied" value="&lt;b&gt;ปฏิเสธการเข้าถึง (Access Denied)&lt;/b&gt;&lt;br/&gt;จอ TFT แสดง &quot;ไม่พบข้อมูลลายนิ้วมือ&quot;&lt;br/&gt;&amp;rarr; คืนสู่หน้าจอหลัก Idle ภายใน 3 วินาที" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#881337;strokeColor=#f43f5e;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1370" y="930" width="240" height="70" as="geometry" /></mxCell><mxCell id="sched_merge" value="&lt;b&gt;4. ตรวจสอบบริบทห้องเรียนและคาบสอน&lt;/b&gt;&lt;br/&gt;ดึงข้อมูลตารางเรียนปัจจุบันจาก &lt;code&gt;active_room.json&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e293b;strokeColor=#475569;strokeWidth=2;fontColor=#f8fafc;fontSize=12;" parent="1" vertex="1"><mxGeometry x="960" y="1050" width="360" height="65" as="geometry" /></mxCell><mxCell id="sched_dec" value="&lt;b&gt;อยู่ในเวลาเรียน&lt;br/&gt;ตามตารางสอน?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1035" y="1150" width="210" height="80" as="geometry" /></mxCell><mxCell id="dup_check" value="&lt;b&gt;ตรวจสอบการเช็คชื่อรายสัปดาห์ (ISO-8601)&lt;/b&gt;&lt;br/&gt;ตรวจสอบประวัติจาก &lt;code&gt;attendance_cache.json&lt;/code&gt;&lt;br/&gt;(จำกัด 1 ครั้งต่อสัปดาห์ต่อวิชา)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e293b;strokeColor=#475569;strokeWidth=2;fontColor=#f8fafc;fontSize=12;" parent="1" vertex="1"><mxGeometry x="830" y="1265" width="280" height="75" as="geometry" /></mxCell><mxCell id="dup_dec" value="&lt;b&gt;เคยเช็คชื่อใน&lt;br/&gt;สัปดาห์นี้หรือยัง?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="865" y="1375" width="210" height="80" as="geometry" /></mxCell><mxCell id="dup_alert" value="&lt;b&gt;แจ้งเตือน: ลงเวลาซ้ำ (Already Checked In)&lt;/b&gt;&lt;br/&gt;จอ TFT แสดง &quot;ลงเวลาไปแล้วในสัปดาห์นี้&quot;&lt;br/&gt;&amp;rarr; ข้ามการบันทึก &amp;amp; คืนสู่หน้าหลัก" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#881337;strokeColor=#f43f5e;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="660" y="1495" width="230" height="75" as="geometry" /></mxCell><mxCell id="calc_status" value="&lt;b&gt;ประเมินเวลาเข้าเรียน (Attendance Grading)&lt;/b&gt;&lt;br/&gt;• ไม่เกิน 15 นาทีแรก &amp;rarr; &lt;b&gt;เข้าเรียนตรงเวลา (ON_TIME)&lt;/b&gt;&lt;br/&gt;• เกิน 15 นาที &amp;rarr; &lt;b&gt;มาสาย (LATE)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e293b;strokeColor=#475569;strokeWidth=2;fontColor=#f8fafc;fontSize=12;" parent="1" vertex="1"><mxGeometry x="920" y="1495" width="270" height="75" as="geometry" /></mxCell><mxCell id="general_access" value="&lt;b&gt;นอกเวลาเรียน (General Access)&lt;/b&gt;&lt;br/&gt;บันทึกลงประวัติเข้าห้องทั่วไป (&lt;code&gt;access_logs&lt;/code&gt;)&lt;br/&gt;ไม่ติดเงื่อนไขสแกนซ้ำรายสัปดาห์" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e293b;strokeColor=#475569;strokeWidth=2;fontColor=#f8fafc;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1220" y="1380" width="280" height="75" as="geometry" /></mxCell><mxCell id="render_bridge" value="&lt;b&gt;5. เรนเดอร์การ์ดผลลัพธ์ผ่าน Linux SoC&lt;/b&gt;&lt;br/&gt;• Python Pillow + TrueType &lt;code&gt;tahoma.ttf&lt;/code&gt; (160x128 แนวนอน)&lt;br/&gt;• บีบอัดเป็น 1-bit Monochrome Bitmap (2,560 ไบต์)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e3a8a;strokeColor=#3b82f6;strokeWidth=2;fontColor=#ffffff;fontSize=12;" parent="1" vertex="1"><mxGeometry x="960" y="1620" width="360" height="75" as="geometry" /></mxCell><mxCell id="send_uart" value="&lt;b&gt;6. ส่งภาพผ่าน 16-Byte Chunking Protocol&lt;/b&gt;&lt;br/&gt;• ซอย 160 ชิ้น (ชิ้นละ 16B หน่วง 5ms) ป้องกัน UART FIFO 64B ล้น&lt;br/&gt;• โหมด Quiet UART &amp;rarr; STM32 ขับจอ 1.8&quot; TFT SPI (ST7735)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e3a8a;strokeColor=#3b82f6;strokeWidth=2;fontColor=#ffffff;fontSize=12;" parent="1" vertex="1"><mxGeometry x="960" y="1730" width="360" height="75" as="geometry" /></mxCell><mxCell id="display_tft" value="&lt;b&gt;7. จอ TFT 1.8&quot; แสดงข้อมูลนักศึกษา &amp;amp; รอยืนยัน&lt;/b&gt;&lt;br/&gt;แสดงชื่อวิชา, ชื่อนักศึกษา, สถานะเวลาเรียน (Timeout 10s)&lt;br/&gt;[ ปุ่มฟ้า D2: ยืนยัน | ปุ่มแดง D3: สแกนใหม่ ]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1e3a8a;strokeColor=#3b82f6;strokeWidth=2;fontColor=#ffffff;fontSize=12;" parent="1" vertex="1"><mxGeometry x="960" y="1840" width="360" height="75" as="geometry" /></mxCell><mxCell id="btn_dec" value="&lt;b&gt;การยืนยันตัวตนทางกายภาพ&lt;br/&gt;(Physical 2-Step)?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#b45309;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1035" y="1955" width="210" height="85" as="geometry" /></mxCell><mxCell id="btn_cancel" value="&lt;b&gt;ปุ่มแดง D3 / หมดเวลา 10 วิ&lt;/b&gt;&lt;br/&gt;- ยกเลิกการลงเวลา&lt;br/&gt;- จอ TFT แสดง &quot;ยกเลิกการลงเวลา&quot;&lt;br/&gt;&amp;rarr; คืนสู่หน้าจอหลัก Idle" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#881337;strokeColor=#f43f5e;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="780" y="2090" width="240" height="80" as="geometry" /></mxCell><mxCell id="btn_confirm" value="&lt;b&gt;ปุ่มฟ้า D2 (ยืนยันสำเร็จ)&lt;/b&gt;&lt;br/&gt;- บันทึกลง &lt;code&gt;session_attendance&lt;/code&gt;&lt;br/&gt;- &lt;b&gt;ออนไลน์:&lt;/b&gt; ยิง Socket.IO ขึ้น Supabase Cloud&lt;br/&gt;- &lt;b&gt;ออฟไลน์:&lt;/b&gt; เก็บลงคิว &lt;code&gt;offline_queue.json&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#065f46;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" parent="1" vertex="1"><mxGeometry x="1040" y="2090" width="270" height="85" as="geometry" /></mxCell><mxCell id="scan_finish" value="&lt;b&gt;✓ บันทึกเวลาสำเร็จ ✓&lt;/b&gt;&lt;br/&gt;จอ TFT แสดงผลสำเร็จ 3 วินาที&lt;br/&gt;&amp;rarr; วนกลับสู่หน้าจอหลัก (Idle) พร้อมรับคนถัดไป" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#0f766e;strokeColor=#14b8a6;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=14;" parent="1" vertex="1"><mxGeometry x="1060" y="2220" width="230" height="65" as="geometry" /></mxCell><mxCell id="e_dec_scan" value="ไม่ใช่ (No)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;fontColor=#fb7185;fontStyle=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="dec_adduser" target="scan_idle" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_scan_1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="scan_idle" target="scan_touch" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_scan_2_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="scan_touch" target="scan_search_t1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_scan_3_dec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="scan_search_t1" target="scan_dec_t1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_t1_yes" value="พบในเซนเซอร์" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontStyle=1;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="scan_dec_t1" target="scan_t1_found" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_t1_no" value="ไม่พบ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;fontColor=#fb7185;fontStyle=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="scan_dec_t1" target="scan_t2_search" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_t2_dec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="scan_t2_search" target="scan_dec_t2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_t2_yes" value="พบใน Cloud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontStyle=1;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="scan_dec_t2" target="scan_t2_promote" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_t2_no" value="ไม่พบใน Cloud" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;fontColor=#fb7185;fontStyle=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="scan_dec_t2" target="scan_denied" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_merge_t1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" parent="1" source="scan_t1_found" target="sched_merge" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_merge_t2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" parent="1" source="scan_t2_promote" target="sched_merge" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_sched_dec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="sched_merge" target="sched_dec" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_sched_yes" value="ในเวลาเรียน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontStyle=1;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="sched_dec" target="dup_check" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_sched_no" value="นอกเวลาเรียน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;fontColor=#fb7185;fontStyle=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="sched_dec" target="general_access" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_dup_dec" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="dup_check" target="dup_dec" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_dup_yes" value="สแกนซ้ำสัปดาห์นี้" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;fontColor=#fb7185;fontStyle=1;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="dup_dec" target="dup_alert" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_dup_no" value="ยังไม่เคยสแกน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="dup_dec" target="calc_status" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_render_calc" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" source="calc_status" target="render_bridge" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_render_gen" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" parent="1" source="general_access" target="render_bridge" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_render_uart" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="render_bridge" target="send_uart" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_uart_tft" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="send_uart" target="display_tft" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_tft_btn" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="display_tft" target="btn_dec" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_btn_cancel" value="ปุ่มแดง D3 / Timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f43f5e;strokeWidth=2;fontColor=#fb7185;fontStyle=1;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="btn_dec" target="btn_cancel" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_btn_confirm" value="ปุ่มฟ้า D2 ยืนยัน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#34d399;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="btn_dec" target="btn_confirm" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_btn_finish" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;" parent="1" source="btn_confirm" target="scan_finish" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_loop_finish" value="วนกลับหน้ารอสแกน" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="scan_finish" target="scan_idle" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_loop_cancel" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="btn_cancel" target="scan_idle" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_loop_dup" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="dup_alert" target="scan_idle" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_loop_denied" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#94a3b8;strokeWidth=2;fontColor=#e2e8f0;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="scan_denied" target="scan_idle" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>